    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["bolide_headlightframe_R", ["bolide_headlight_R"]],
         {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"sealedbeam", "deformMaterialDamaged":"sealedbeam"},
         ["bolide_headlight_a_R", ["bolide_headlight_R"]],
         {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"sealedbeam_glass", "deformMaterialDamaged":"sealedbeam_glass_dmg"},
