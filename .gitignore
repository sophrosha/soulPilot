# === Python venv и кэш ===
ai/venv/
__pycache__/
*.pyc

# === Релизные архивы ===
dist/

# === Рабочие данные проекта: по умолчанию в git НЕ идут ===
# Маленькие примеры можно добавить принудительно: git add -f ai/csv/example.csv
ai/logs/*
ai/csv/*
ai/road/*
!ai/logs/.gitkeep
!ai/csv/.gitkeep
!ai/road/.gitkeep
# Фаза 2: схема и маленькие артефакты графа — коммитим, большой graph.json — нет
!ai/road/graph_schema.md
!ai/road/graph.example.json
!ai/road/marks.csv
ai/road/graph.json

# === Служебное ===
Thumbs.db
Desktop.ini
.DS_Store

# Фаза 2: полный список предупреждений экспорта графа (лимит 10 в meta.warnings)
ai/road/warnings.txt

# Фаза 8 (24.10): старые копии модулей (не грузятся игрой, только для истории)
ai/notes/legacy/

# Фаза 11 (25.10): Spotify/Audio-Reactive — рабочее состояние пишет Python
# (атомарно, temp+replace); в git не нужно.
ai/music/current.json
ai/music/*.tmp.*
# Настройки UI (устройство захвата) — локальные для машины игрока.
ai/music/config.json
